generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model attachment {
  id                 Int                  @id @default(autoincrement())
  uuid               Bytes                @unique(map: "uuid") @db.Binary(16)
  file_name          String               @db.VarChar(255)
  file_size          Int                  @default(0)
  file_path          String               @default("0") @db.VarChar(255)
  mime_type          String               @db.VarChar(50)
  extension          String               @db.VarChar(50)
  uploaded_at        DateTime             @default(now()) @db.DateTime(0)
  uploaded_by        Int                  @default(0)
  permohonan_dokumen permohonan_dokumen[]
}

model audit_event {
  id          Int         @id @default(autoincrement())
  event_time  DateTime    @default(now()) @db.DateTime(0)
  user_id     Int?
  ip_address  String?     @db.VarChar(45)
  event       String      @db.VarChar(50)
  description String?     @db.VarChar(500)
  audit_log   audit_log[]
}

model audit_log {
  id           Int         @id @default(autoincrement())
  event_id     Int
  object_type  String      @db.VarChar(50)
  object_id    String      @db.VarChar(50)
  changed_data Json?
  audit_event  audit_event @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_event")

  @@index([event_id], map: "fk_audit_log_event")
}

model email_queue {
  id         Int                 @id @default(autoincrement())
  recipient  String              @db.VarChar(255)
  subject    String              @db.VarChar(255)
  body       String              @db.Text
  status     email_queue_status? @default(pending)
  attempts   Int                 @default(0)
  last_error String?             @db.Text
  created_at DateTime            @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at DateTime            @default(dbgenerated("'now()'")) @db.DateTime(0)
  sent_at    DateTime?           @db.DateTime(0)
}

model email_template {
  id          Int      @id @default(autoincrement())
  key         String   @default("0") @db.VarChar(50)
  description String?  @default("0") @db.VarChar(255)
  title       String   @default("0") @db.VarChar(255)
  content     String   @default("0") @db.VarChar(5000)
  created_at  DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at  DateTime @default(dbgenerated("'now()'")) @db.DateTime(0)
}

model error_logs {
  id         Int      @id @default(autoincrement())
  uuid       Bytes    @unique(map: "uuid") @default(dbgenerated("0x30")) @db.Binary(16)
  type       String   @default("0") @db.VarChar(50)
  message    String   @db.Text
  file       String?  @db.VarChar(255)
  line       Int?
  trace      String?  @db.LongText
  context    String?  @db.VarChar(255)
  user_id    Int?
  ip_address String?  @db.VarChar(45)
  method     String?  @db.VarChar(10)
  url        String?  @db.VarChar(255)
  created_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
}

model menu {
  id          Int         @id @default(autoincrement())
  parent_id   Int?
  name        String      @default("") @db.VarChar(100)
  label_ms    String      @default("") @db.VarChar(100)
  label_en    String      @default("") @db.VarChar(100)
  description String?     @db.VarChar(100)
  icon_name   String?     @db.VarChar(100)
  icon_color  String?     @db.VarChar(100)
  url         String      @default("") @db.VarChar(255)
  order       Int         @default(0)
  status      Int         @default(1)
  created_at  DateTime    @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by  Int         @default(0)
  updated_at  DateTime    @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by  Int         @default(0)
  menu        menu?       @relation("menuTomenu", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_menu_parent")
  other_menu  menu[]      @relation("menuTomenu")
  role_menu   role_menu[]

  @@index([parent_id], map: "fk_menu_parent")
}

model password_resets {
  id         Int      @id @default(autoincrement())
  user_id    Int
  password   String   @default("") @db.VarChar(255)
  created_at DateTime @default(now()) @db.DateTime(0)
  created_by Int      @default(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_resets_ibfk_1")

  @@index([user_id], map: "user_id")
}

model permission {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "name") @db.VarChar(150)
  description     String?           @db.VarChar(255)
  created_at      DateTime          @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by      Int               @default(0)
  updated_at      DateTime          @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by      Int               @default(0)
  role_permission role_permission[]
}

model pertanyaan {
  id                      Int                             @id @default(autoincrement())
  uuid                    Bytes                           @unique(map: "uuid") @default(dbgenerated("0x30783330")) @db.Binary(16)
  name                    String                          @default("0") @db.VarChar(255)
  phone_no                String                          @default("0") @db.VarChar(50)
  email                   String                          @default("0") @db.VarChar(50)
  kod_kategori_pertanyaan String                          @default("0") @db.Char(5)
  question                String                          @default("0") @db.VarChar(1000)
  status                  pertanyaan_status               @default(N)
  notes                   String?                         @db.VarChar(500)
  created_at              DateTime                        @default(now()) @db.DateTime(0)
  updated_at              DateTime                        @default(now()) @db.DateTime(0)
  answered_at             DateTime?                       @db.DateTime(0)
  answered_by             Int?
  kaedah_maklum_balas     pertanyaan_kaedah_maklum_balas?
  ref_kategori_pertanyaan ref_kategori_pertanyaan         @relation(fields: [kod_kategori_pertanyaan], references: [kod_kategori_pertanyaan], onDelete: NoAction, onUpdate: NoAction, map: "fk_pertanyaan_kategori_pertanyaan")

  @@index([kod_kategori_pertanyaan], map: "fk_pertanyaan_ref_kategori_pertanyaan")
}

model role {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "name") @default("") @db.VarChar(100)
  description     String?           @default("") @db.VarChar(255)
  created_at      DateTime          @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by      Int               @default(0)
  updated_at      DateTime          @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by      Int               @default(0)
  role_menu       role_menu[]
  role_permission role_permission[]
  user_role       user_role[]
}

model role_menu {
  role_id    Int      @default(0)
  menu_id    Int      @default(0)
  created_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by Int      @default(0)
  updated_at DateTime @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by Int      @default(0)
  menu       menu     @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_menu_menu")
  role       role     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_menu_role")

  @@id([menu_id, role_id])
  @@index([role_id], map: "fk_role")
  @@index([menu_id], map: "fk_menu")
}

model role_permission {
  role_id       Int        @default(0)
  permission_id Int        @default(0)
  created_at    DateTime   @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by    Int        @default(0)
  updated_at    DateTime   @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by    Int        @default(0)
  permission    permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permission_permission")
  role          role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permission_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_role_permission_permission")
  @@index([role_id], map: "fk_role_permission_role")
}

model tapak_perkuburan {
  id                       Int                     @id @default(autoincrement())
  nama_tapak               String                  @db.VarChar(100)
  lokasi_tapak             String                  @default("") @db.VarChar(255)
  keluasan_tapak           Decimal?                @db.Decimal(20, 6)
  kapasiti_lot_keseluruhan Int?
  description              String?                 @db.VarChar(255)
  created_at               DateTime                @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by               Int                     @default(0)
  updated_at               DateTime                @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by               Int                     @default(0)
  lot_kubur                lot_kubur[]
  user_tapak_perkuburan    user_tapak_perkuburan[]
  zon_tapak_perkuburan     zon_tapak_perkuburan[]
}

model user_profile {
  id               Int                            @id @default(autoincrement())
  user_id          Int
  full_name        String?                        @db.VarChar(100)
  phone_no         String?                        @db.VarChar(15)
  email            String?                        @db.VarChar(100)
  gender           user_profile_gender?
  jenis_pengenalan user_profile_jenis_pengenalan?
  no_pengenalan    String?                        @db.VarChar(12)
  address1         String?                        @db.VarChar(300)
  address2         String?                        @db.VarChar(300)
  address3         String?                        @db.VarChar(300)
  bandar           String?                        @db.VarChar(100)
  daerah           String?                        @db.VarChar(100)
  negeri           String?                        @db.VarChar(100)
  created_at       DateTime                       @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by       Int?
  updated_at       DateTime                       @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by       Int?
  users            users                          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_user_profile")

  @@index([user_id], map: "fk_user_user_profile")
}

model user_role {
  user_id    Int      @default(0)
  role_id    Int      @default(0)
  created_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
  created_by Int      @default(0)
  updated_at DateTime @default(dbgenerated("'now()'")) @db.DateTime(0)
  updated_by Int      @default(0)
  role       role     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role")
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user")

  @@id([user_id, role_id])
  @@index([role_id], map: "fk_role")
  @@index([user_id], map: "fk_user")
}

model user_tokens {
  id               Int      @id @default(autoincrement())
  user_id          Int
  selector         String   @db.Char(12)
  hashed_validator String   @db.Char(64)
  expires          DateTime @db.DateTime(0)
  created_at       DateTime @default(now()) @db.DateTime(0)
  updated_at       DateTime @default(now()) @db.DateTime(0)
  users            users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_tokens_ibfk_1")

  @@index([selector], map: "selector")
  @@index([user_id], map: "user_id")
}

model users {
  id                         Int                     @id @default(autoincrement())
  username                   String                  @unique(map: "username") @db.VarChar(100)
  password                   String                  @db.VarChar(255)
  is_password_reset_required Boolean
  is_email_verified          Boolean
  email_verification_token   String?                 @db.VarChar(128)
  email_verified_at          DateTime?               @db.DateTime(0)
  created_at                 DateTime                @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at                 DateTime                @default(dbgenerated("'now()'")) @db.DateTime(0)
  password_history           password_history[]
  password_resets            password_resets[]
  user_profile               user_profile[]
  user_role                  user_role[]
  user_tapak_perkuburan      user_tapak_perkuburan[]
  user_tokens                user_tokens[]
}

model refresh_token {
  id         Int      @id @default(autoincrement())
  user_id    Int      @default(0)
  token      String   @db.Text
  expires_at DateTime @db.DateTime(0)
  is_revoked Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)
}

model lot_kubur {
  id                   Int                   @id @default(autoincrement())
  tapak_perkuburan_id  Int
  zon_id               Int
  kod_kategori_jenazah String?               @db.Char(4)
  kategori_jenazah_id  Int?
  no_lot               String                @default("") @db.VarChar(50)
  kod_status_kubur     String                @default("AV") @db.Char(2)
  gis_id               Int?
  created_at           DateTime              @default(now()) @db.DateTime(0)
  created_by           Int                   @default(0)
  updated_at           DateTime              @default(now()) @db.DateTime(0)
  updated_by           Int                   @default(0)
  ref_kategori_jenazah ref_kategori_jenazah? @relation(fields: [kategori_jenazah_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lot_kubur_kategori_jenazah")
  ref_status_kubur     ref_status_kubur      @relation(fields: [kod_status_kubur], references: [kod_status_kubur], onDelete: NoAction, onUpdate: NoAction, map: "fk_lot_kubur_ref_status_kubur")
  tapak_perkuburan     tapak_perkuburan      @relation(fields: [tapak_perkuburan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lot_kubur_tapak_perkuburan")
  zon_tapak_perkuburan zon_tapak_perkuburan  @relation(fields: [zon_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lot_kubur_zon_tapak_perkuburan")

  @@index([kategori_jenazah_id], map: "fk_lot_kubur_kategori_jenazah")
  @@index([kod_status_kubur], map: "fk_lot_kubur_ref_status_kubur")
  @@index([tapak_perkuburan_id], map: "fk_lot_kubur_tapak_perkuburan")
  @@index([zon_id], map: "fk_lot_kubur_zon_tapak_perkuburan")
  @@index([kod_kategori_jenazah], map: "fk_lot_kubur_ref_kategori_jenazah")
}

model password_history {
  id           Int      @id @default(autoincrement())
  user_id      Int
  selector     String   @db.Char(12)
  hashed_token String   @db.Char(64)
  expires_at   DateTime @db.DateTime(0)
  created_at   DateTime @default(now()) @db.DateTime(0)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_history_ibfk_1")

  @@index([selector], map: "selector")
  @@index([user_id], map: "user_id")
}

model permohonan {
  id                       Int                          @id @default(autoincrement())
  uuid                     Bytes                        @unique(map: "uuid") @db.Binary(16)
  no_permohonan            String                       @db.VarChar(50)
  kod_jenis_permohonan     String                       @default("") @db.Char(2)
  ref_kategori_jenazah_id  Int
  status_permohonan        permohonan_status_permohonan @default(DRAFT)
  created_at               DateTime                     @default(now()) @db.DateTime(0)
  created_by               Int                          @default(0)
  updated_at               DateTime                     @default(now()) @db.DateTime(0)
  updated_by               Int                          @default(0)
  ref_jenis_permohonan     ref_jenis_permohonan         @relation(fields: [kod_jenis_permohonan], references: [kod_jenis_permohonan], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_kod_jenis_permohonan")
  permohonan_anggota_badan permohonan_anggota_badan[]
  permohonan_bayaran       permohonan_bayaran[]
  permohonan_dokumen       permohonan_dokumen[]
  permohonan_haiwan        permohonan_haiwan[]
  permohonan_jenazah       permohonan_jenazah[]
  permohonan_notes         permohonan_notes[]
  permohonan_pemohon       permohonan_pemohon[]

  @@index([ref_kategori_jenazah_id], map: "fk_permohonan_ref_kategori_jenazah")
  @@index([kod_jenis_permohonan], map: "fk_permohonan_ref_jenis_permohonan")
}

model permohonan_anggota_badan {
  id                     Int        @id @default(autoincrement())
  permohonan_id          Int        @default(0)
  ref_bahagian_badan_kod String     @default("") @db.Char(4)
  bahagian_badan_others  String?    @default("") @db.VarChar(255)
  created_at             DateTime   @default(now()) @db.DateTime(0)
  created_by             Int        @default(0)
  updated_at             DateTime   @default(now()) @db.DateTime(0)
  updated_by             Int        @default(0)
  permohonan             permohonan @relation(fields: [permohonan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_anggota_badan_permohonan")

  @@index([permohonan_id], map: "fk_permohonan_anggota_badan_permohonan")
  @@index([ref_bahagian_badan_kod], map: "fk_permohonan_anggota_badan_ref_bahagian_badan")
}

model permohonan_bayaran {
  id               Int                       @id @default(autoincrement())
  no_akaun         String?                   @db.VarChar(50)
  no_bil_pelbagai  String?                   @db.VarChar(50)
  no_resit         String?                   @default("") @db.VarChar(50)
  permohonan_id    Int
  payment_deadline DateTime?                 @db.DateTime(0)
  status_bayaran   permohonan_bayaran_status @default(PENDING)
  created_at       DateTime                  @default(now()) @db.DateTime(0)
  created_by       Int                       @default(0)
  updated_at       DateTime                  @default(now()) @db.DateTime(0)
  updated_by       Int                       @default(0)
  permohonan       permohonan                @relation(fields: [permohonan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_bayaran_permohonan")

  @@index([permohonan_id], map: "fk_permohonan_bayaran_permohonan")
}

model permohonan_detail {
  id                       Int                                  @id @default(autoincrement())
  permohonan_id            Int
  tapak_perkuburan_id      Int?
  status_pengebumian       permohonan_detail_status_pengebumian @default(PENDING)
  masa_dipilih_pemohon     DateTime                             @db.DateTime(0)
  masa_ditetapkan_pegawai  DateTime?                            @db.DateTime(0)
  masa_selesai_pengebumian DateTime?                            @db.DateTime(0)
  is_in_kawasan_mbjb       Boolean                              @default(false)
  lot_id                   Int                                  @default(0)
  created_at               DateTime                             @default(now()) @db.DateTime(0)
  created_by               Int                                  @default(0)
  updated_at               DateTime                             @default(now()) @db.DateTime(0)
  updated_by               Int                                  @default(0)

  @@index([lot_id], map: "fk_permohonan_detail_lot_kubur")
  @@index([permohonan_id], map: "fk_permohonan_detail_permohonan")
  @@index([tapak_perkuburan_id], map: "fk_permohonan_detail_tapak_perkuburan")
}

model permohonan_dokumen {
  id            Int         @id @default(autoincrement())
  permohonan_id Int
  jenis_dokumen String      @default("") @db.VarChar(50)
  attachment_id Int?        @default(0)
  created_at    DateTime    @default(now()) @db.DateTime(0)
  created_by    Int         @default(0)
  updated_at    DateTime    @default(now()) @db.DateTime(0)
  updated_by    Int         @default(0)
  attachment    attachment? @relation(fields: [attachment_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_dokumen_attachment")
  permohonan    permohonan  @relation(fields: [permohonan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_dokumen_permohonan")

  @@index([attachment_id], map: "fk_permohonan_dokumen_attachment")
  @@index([permohonan_id], map: "fk_permohonan_dokumen_permohonan")
}

model permohonan_haiwan {
  id                   Int        @id @default(autoincrement())
  permohonan_id        Int
  ref_jenis_haiwan_kod String     @default("") @db.Char(4)
  created_at           DateTime   @default(now()) @db.DateTime(0)
  created_by           Int        @default(0)
  updated_at           DateTime   @default(now()) @db.DateTime(0)
  updated_by           Int        @default(0)
  permohonan           permohonan @relation(fields: [permohonan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_haiwan_permohonan")

  @@index([permohonan_id], map: "fk_permohonan_haiwan_permohonan")
  @@index([ref_jenis_haiwan_kod], map: "fk_permohonan_haiwan_ref_jenis_haiwan")
}

model permohonan_jenazah {
  id                      Int                  @id @default(autoincrement())
  permohonan_id           Int
  nama_jenazah            String               @default("") @db.VarChar(50)
  kod_warganegara         String               @default("") @db.Char(2)
  jenis_pengenalan        String               @default("") @db.VarChar(8)
  no_pengenalan           String               @db.VarChar(20)
  ref_bangsa_id           Int                  @default(0)
  kod_jantina             String               @default("0") @db.VarChar(50)
  ref_kategori_jenazah_id Int                  @default(0)
  tarikh_lahir            DateTime             @db.Date
  masa_sah_kematian       DateTime?            @db.DateTime(0)
  address1                String               @default("") @db.VarChar(500)
  address2                String               @default("") @db.VarChar(500)
  address3                String               @default("") @db.VarChar(500)
  poskod                  String?              @db.Char(6)
  created_at              DateTime             @default(now()) @db.DateTime(0)
  created_by              Int                  @default(0)
  updated_at              DateTime             @default(now()) @db.DateTime(0)
  updated_by              Int                  @default(0)
  ref_kategori_jenazah    ref_kategori_jenazah @relation(fields: [ref_kategori_jenazah_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_jenazah_kategori_jenazah")
  permohonan              permohonan           @relation(fields: [permohonan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_jenazah_permohonan")
  ref_bangsa              ref_bangsa           @relation(fields: [ref_bangsa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_jenazah_ref_bangsa")
  ref_negara              ref_negara           @relation(fields: [kod_warganegara], references: [kod_negara], onDelete: NoAction, onUpdate: NoAction, map: "fk_permohonan_jenazah_ref_negara")

  @@index([ref_kategori_jenazah_id], map: "fk_permohonan_jenazah_kategori_jenazah")
  @@index([permohonan_id], map: "fk_permohonan_jenazah_permohonan")
  @@index([ref_bangsa_id], map: "fk_permohonan_jenazah_ref_bangsa")
  @@index([kod_warganegara], map: "fk_permohonan_jenazah_ref_negara")
  @@index([poskod], map: "fk_permohonan_jenazah_ref_poskod")
}

model permohonan_notes {
  id            Int        @id @default(autoincrement())
  permohonan_id Int
