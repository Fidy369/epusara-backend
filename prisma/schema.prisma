generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model attachment {
  id          Int      @id @default(autoincrement())
  uuid        String   @default("") @db.VarChar(50)
  file_name   String   @db.VarChar(255)
  file_size   Int      @default(0)
  file_path   String   @default("0") @db.VarChar(255)
  mime_type   String   @db.VarChar(50)
  extension   String   @db.VarChar(50)
  user_id     Int      @default(0)
  uploaded_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
}

model audit_event {
  id          Int         @id @default(autoincrement())
  event_time  DateTime    @default(now()) @db.DateTime(0)
  user_id     Int?
  ip_address  String?     @db.VarChar(45)
  event       String      @db.VarChar(50)
  description String?     @db.VarChar(500)
  audit_log   audit_log[]
}

model audit_log {
  id           Int         @id @default(autoincrement())
  event_id     Int
  object_type  String      @db.VarChar(50)
  object_id    String      @db.VarChar(50)
  changed_data Json?
  audit_event  audit_event @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_event")

  @@index([event_id], map: "fk_audit_log_event")
}

model email_queue {
  id         Int                 @id @default(autoincrement())
  recipient  String              @db.VarChar(255)
  subject    String              @db.VarChar(255)
  body       String              @db.Text
  status     email_queue_status? @default(pending)
  attempts   Int                 @default(0)
  last_error String?             @db.Text
  created_at DateTime            @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at DateTime            @default(dbgenerated("'now()'")) @db.DateTime(0)
  sent_at    DateTime?           @db.DateTime(0)
}

model email_template {
  id          Int      @id @default(autoincrement())
  key         String   @default("0") @db.VarChar(50)
  description String?  @default("0") @db.VarChar(255)
  title       String   @default("0") @db.VarChar(255)
  content     String   @default("0") @db.VarChar(5000)
  created_at  DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at  DateTime @default(dbgenerated("'now()'")) @db.DateTime(0)
}

model error_logs {
  id         Int      @id @default(autoincrement())
  type       String   @default("0") @db.VarChar(50)
  message    String   @db.Text
  file       String?  @db.VarChar(255)
  line       Int?
  trace      String?  @db.LongText
  context    String?  @db.VarChar(255)
  user_id    Int?
  ip_address String?  @db.VarChar(45)
  method     String?  @db.VarChar(10)
  url        String?  @db.VarChar(255)
  created_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
}

model menu {
  id          Int         @id @default(autoincrement())
  parent_id   Int?
  name        String      @default("") @db.VarChar(100)
  label_ms    String      @default("") @db.VarChar(100)
  label_en    String      @default("") @db.VarChar(100)
  description String?     @db.VarChar(100)
  icon_name   String?     @db.VarChar(100)
  icon_color  String?     @db.VarChar(100)
  url         String      @default("") @db.VarChar(255)
  order       Int         @default(0)
  status      Int         @default(1)
  created_at  DateTime    @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at  DateTime    @default(dbgenerated("'now()'")) @db.DateTime(0)
  menu        menu?       @relation("menuTomenu", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_menu_parent")
  other_menu  menu[]      @relation("menuTomenu")
  role_menu   role_menu[]

  @@index([parent_id], map: "fk_menu_parent")
}

model password_resets {
  id           Int      @id @default(autoincrement())
  user_id      Int
  selector     String   @db.Char(12)
  hashed_token String   @db.Char(64)
  expires_at   DateTime @db.DateTime(0)
  created_at   DateTime @default(now()) @db.DateTime(0)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_resets_ibfk_1")

  @@index([selector], map: "selector")
  @@index([user_id], map: "user_id")
}

model permission {
  id              Int               @id @default(autoincrement())
  name            String            @unique(map: "name") @db.VarChar(150)
  description     String?           @db.VarChar(255)
  created_at      DateTime          @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at      DateTime          @default(dbgenerated("'now()'")) @db.DateTime(0)
  role_permission role_permission[]
}

model pertanyaan {
  id          Int               @id @default(autoincrement())
  name        String            @default("0") @db.VarChar(255)
  phone_no    String            @default("0") @db.VarChar(50)
  email       String            @default("0") @db.VarChar(50)
  category    Int               @default(0)
  question    String            @default("0") @db.VarChar(1000)
  status      pertanyaan_status @default(N)
  notes       String?           @db.VarChar(500)
  created_at  DateTime          @default(now()) @db.DateTime(0)
  updated_at  DateTime          @default(now()) @db.DateTime(0)
  answered_at DateTime?         @db.DateTime(0)
  answered_by Int?
}

model role {
  id              Int               @id @default(autoincrement())
  name            String            @default("") @db.VarChar(100)
  description     String?           @default("") @db.VarChar(255)
  created_at      DateTime          @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at      DateTime          @default(dbgenerated("'now()'")) @db.DateTime(0)
  role_menu       role_menu[]
  role_permission role_permission[]
  user_role       user_role[]
}

model role_menu {
  id         Int      @id @default(autoincrement())
  role_id    Int      @default(0)
  menu_id    Int      @default(0)
  created_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at DateTime @default(dbgenerated("'now()'")) @db.DateTime(0)
  menu       menu     @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_menu_menu")
  role       role     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_menu_role")

  @@index([role_id], map: "fk_role")
  @@index([menu_id, role_id], map: "user_id_role_id")
}

model role_permission {
  id            Int        @id @default(autoincrement())
  role_id       Int        @default(0)
  permission_id Int        @default(0)
  created_at    DateTime   @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at    DateTime   @default(dbgenerated("'now()'")) @db.DateTime(0)
  permission    permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permission_permission")
  role          role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permission_role")

  @@unique([role_id, permission_id], map: "role_id_permission_id")
  @@index([permission_id], map: "fk_role_permission_permission")
}

model tapak_perkuburan {
  id          Int         @id @default(autoincrement())
  nama_tapak  String      @db.VarChar(100)
  description String?     @default("") @db.VarChar(255)
  created_at  DateTime    @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at  DateTime    @default(dbgenerated("'now()'")) @db.DateTime(0)
  user_area   user_area[]
}

model user_area {
  id               Int              @id @default(autoincrement())
  user_id          Int              @default(0)
  tapak_id         Int              @default(0)
  created_at       DateTime         @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at       DateTime         @default(dbgenerated("'now()'")) @db.DateTime(0)
  tapak_perkuburan tapak_perkuburan @relation(fields: [tapak_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_area_area")
  users            users            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_area_user")

  @@index([tapak_id], map: "fk_role")
  @@index([user_id, tapak_id], map: "user_id_role_id")
}

model user_profile {
  id         Int                  @id @default(autoincrement())
  user_id    Int
  full_name  String?              @db.VarChar(100)
  phone      String?              @db.VarChar(15)
  email      String?              @db.VarChar(100)
  gender     user_profile_gender?
  birthdate  DateTime?            @db.Date
  created_at DateTime             @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at DateTime             @default(dbgenerated("'now()'")) @db.DateTime(0)
  users      users                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_user_profile")

  @@index([user_id], map: "fk_user_user_profile")
}

model user_role {
  id         Int      @id @default(autoincrement())
  user_id    Int      @default(0)
  role_id    Int      @default(0)
  created_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at DateTime @default(dbgenerated("'now()'")) @db.DateTime(0)
  role       role     @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role")
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user")

  @@index([role_id], map: "fk_role")
  @@index([user_id, role_id], map: "user_id_role_id")
}

model user_tokens {
  id               Int      @id @default(autoincrement())
  user_id          Int
  selector         String   @db.Char(12)
  hashed_validator String   @db.Char(64)
  expires          DateTime @db.DateTime(0)
  users            users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_tokens_ibfk_1")

  @@index([selector], map: "selector")
  @@index([user_id], map: "user_id")
}

model users {
  id                         Int               @id @default(autoincrement())
  username                   String            @db.VarChar(100)
  password                   String            @db.VarChar(255)
  is_password_reset_required Boolean
  is_email_verified          Boolean
  email_verification_token   String?           @db.VarChar(128)
  email_verified_at          DateTime?         @db.DateTime(0)
  created_at                 DateTime          @default(dbgenerated("(now())")) @db.DateTime(0)
  updated_at                 DateTime          @default(dbgenerated("'now()'")) @db.DateTime(0)
  password_resets            password_resets[]
  user_area                  user_area[]
  user_profile               user_profile[]
  user_role                  user_role[]
  user_tokens                user_tokens[]
}

model refresh_token {
  id         Int      @id @default(autoincrement())
  user_id    Int      @default(0)
  token      String   @db.Text
  expires_at DateTime @db.DateTime(0)
  is_revoked Boolean  @default(false)
  created_at DateTime @db.DateTime(0)
}

enum email_queue_status {
  pending
  sent
  failed
}

enum user_profile_gender {
  male
  female
  other
}

enum pertanyaan_status {
  N
  A
}
